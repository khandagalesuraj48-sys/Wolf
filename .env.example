# FALCON – the names of the settings only. The values are set in Vercel → Settings → Environment Variables,
# never in a file and never in chat. "VITE_" ones reach the browser (public by design); the others stay on the server.

# FALCON's own Supabase project (Supabase → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# server only – never with VITE_ in front
SUPABASE_SERVICE_ROLE_KEY=

# The one sign-in of a verified RCL employee: the LION Portal's address (its /api/jwks checks the ticket) – decision of 23-11-2026
PORTAL_URL=

# The company a LION sign-in belongs to (default RCL)
FALCON_COMPANY_CODE=

# FALCON's own sign-in by a WhatsApp code: Supabase's "Send SMS" hook → /api/sms-hook (the same Meta number and the approved
# template "otp") – docs/DECISIONS.md 3
SEND_SMS_HOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=

# RCL ID look-up in HR – not decided yet (docs/DECISIONS.md 2)
HR_LOOKUP_URL=
HR_LOOKUP_SECRET=

# Vercel's daily timer (/api/daily)
CRON_SECRET=

# Google Maps for the delivery map – not decided yet (docs/DECISIONS.md 4)
VITE_GOOGLE_MAPS_KEY=
